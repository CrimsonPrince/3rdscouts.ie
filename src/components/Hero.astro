---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  image?: string;
  overlayOpacity?: number;
  minHeight?: string;
  align?: 'center' | 'left';
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title,
  subtitle,
  eyebrow,
  image = '/images/hero-home.jpg',
  overlayOpacity = 0.52,
  minHeight = '340px',
  align = 'center',
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<section
  class="hero-banner"
  style={`--hero-min-height: ${minHeight}; --hero-overlay: rgba(15, 23, 42, ${overlayOpacity});`}
>
  <img src={image} alt="" class="hero-bg" aria-hidden="true" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class:list={['container hero-content', { 'hero-content--left': align === 'left' }]}>
    {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {ctaLabel && ctaHref && (
      <div class="hero-actions">
        <a href={ctaHref} class="btn btn-red btn-lg">{ctaLabel}</a>
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    min-height: var(--hero-min-height);
    display: flex;
    align-items: center;
    padding-block: 4rem;
    overflow: hidden;
    background-color: var(--color-primary-dark);
    color: #ffffff;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 820px;
  }

  .hero-content--left {
    text-align: left;
    margin-inline: 0;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    margin-bottom: 0.9rem;
    border-radius: var(--radius-pill);
    background-color: rgba(221, 51, 51, 0.92);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 0.9rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-subtitle {
    color: #f1f5f9;
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  .hero-content--left .hero-subtitle {
    margin-inline: 0;
  }

  .hero-actions {
    margin-top: 1.5rem;
  }
</style>
