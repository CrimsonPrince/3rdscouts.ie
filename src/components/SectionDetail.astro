---
import siteData from '../data/siteData.json';

interface SectionUnit {
  name: string;
  description: string;
  email: string;
  icon: string;
}

export interface SectionItem {
  slug: string;
  name: string;
  heading: string;
  ageRange: string;
  accentColor: string;
  icon: string;
  heroImage: string;
  shortDescription: string;
  introParagraphs: string[];
  units: SectionUnit[];
  whatTheyDoTitle: string;
  whatTheyDoParagraphs: string[];
  whatTheyDoImage: string;
  activitiesTitle: string;
  activitiesParagraphs: string[];
  activitiesImage: string;
  ctaTitle: string;
}

interface Props {
  section: SectionItem;
}

const { section } = Astro.props;
const allSections = siteData.sections;
---

<section class="section-hero" style={`--accent: ${section.accentColor};`}>
  <img src={section.heroImage} alt={`${section.name} in action`} class="section-hero-bg" />
  <div class="section-hero-scrim" aria-hidden="true"></div>
  <div class="container section-hero-inner">
    <div class="section-intro-card">
      <div class="intro-badge-row">
        <span class="badge">{section.ageRange}</span>
        <a href="/sections" class="back-link">All 7 Sections &rarr;</a>
      </div>
      <h1>{section.heading}</h1>
      {section.introParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Weekly Meetings &amp; Leadership</span>
      <h2>{section.units.length > 1 ? `Our ${section.name} Units` : section.units[0].name}</h2>
    </div>

    <div class:list={['grid', section.units.length > 1 ? 'grid-2' : 'single-unit-wrap']}>
      {section.units.map((unit) => (
        <article class="card unit-card">
          <div class="card-body unit-card-body">
            <div class="unit-icon-ring">
              <img src={unit.icon} alt={`${unit.name} crest`} width="72" height="72" />
            </div>
            <h3>{unit.name}</h3>
            <p>{unit.description}</p>
            <p class="unit-email">
              <a href={`mailto:${unit.email}`}>{unit.email}</a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container feature-split">
    <div class="feature-media">
      <img src={section.whatTheyDoImage} alt={section.whatTheyDoTitle} loading="lazy" />
    </div>
    <div class="feature-text">
      <span class="section-eyebrow">Programme &amp; Skills</span>
      <h2>{section.whatTheyDoTitle}</h2>
      {section.whatTheyDoParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container feature-split feature-split--reverse">
    <div class="feature-media">
      <img src={section.activitiesImage} alt={section.activitiesTitle} loading="lazy" />
    </div>
    <div class="feature-text">
      <span class="section-eyebrow">Camps &amp; Adventures</span>
      <h2>{section.activitiesTitle}</h2>
      {section.activitiesParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<section class="cta-strip">
  <div class="container cta-strip-inner">
    <div>
      <h2>{section.ctaTitle}</h2>
      <p>Apply online to join our waiting list or learn more about volunteering with {section.name}.</p>
    </div>
    <div class="cta-actions">
      <a href="/join-us" class="btn btn-red btn-lg">Join Us</a>
      <a href="/volunteering" class="btn btn-outline-white btn-lg">Volunteer</a>
    </div>
  </div>
</section>

<section class="section-sm section-alt">
  <div class="container">
    <div class="section-switcher">
      <span class="switcher-label">Browse Other Sections:</span>
      <div class="switcher-pills">
        {allSections.map((item) => (
          <a
            href={`/sections/${item.slug}`}
            class:list={['switcher-pill', { 'is-current': item.slug === section.slug }]}
          >
            {item.name} ({item.ageRange})
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    padding-block: 4rem 3rem;
    background-color: var(--color-primary-dark);
  }

  .section-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .section-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.72), rgba(15, 23, 42, 0.25));
  }

  .section-hero-inner {
    position: relative;
    z-index: 2;
  }

  .section-intro-card {
    max-width: 760px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 2rem 2.25rem;
    border-radius: var(--radius-md);
    border-left: 6px solid var(--accent);
    box-shadow: var(--shadow-lg);
  }

  .intro-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .section-intro-card h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .section-intro-card p:last-child {
    margin-bottom: 0;
  }

  .single-unit-wrap {
    max-width: 560px;
    margin-inline: auto;
  }

  .unit-card-body {
    text-align: center;
    padding: 2rem 1.75rem;
  }

  .unit-icon-ring {
    width: 82px;
    height: 82px;
    margin-inline: auto;
    margin-bottom: 1rem;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .unit-icon-ring img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }

  .unit-card h3 {
    text-transform: uppercase;
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
  }

  .unit-email {
    margin-bottom: 0;
    font-weight: 700;
  }

  .feature-split {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .feature-split {
      grid-template-columns: 1.05fr 1fr;
    }

    .feature-split--reverse .feature-media {
      order: 2;
    }
  }

  .feature-media {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 3;
    background: #e2e8f0;
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-text h2 {
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .section-switcher {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .switcher-label {
    font-weight: 700;
    color: var(--color-darker);
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .switcher-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .switcher-pill {
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    background: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-darker);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .switcher-pill:hover,
  .switcher-pill.is-current {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
  }
</style>
